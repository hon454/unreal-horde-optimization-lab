{
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "../unreal-horde-references/"
    ],
    "allow": [
      "Read",
      "Bash(powershell -ExecutionPolicy Bypass -File Scripts/build.ps1:*)",
      "Bash(powershell -ExecutionPolicy Bypass -File Scripts/package.ps1:*)",
      "Bash(powershell -ExecutionPolicy Bypass -File Scripts/run-bench.ps1:*)",
      "Bash(powershell -ExecutionPolicy Bypass -File Scripts/run-dev.ps1:*)",
      "Bash(py -3 Scripts/summarize.py:*)",
      "Bash(py -3 Scripts/plot.py:*)",
      "Bash(powershell -NoProfile -Command \"Get-Process *)",
      "mcp__computer-use__list_granted_applications",
      "Bash(git push origin main:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git tag:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git lfs:*)",
      "Bash(rg:*)",
      "Bash(Get-Content:*)",
      "Bash(Get-ChildItem:*)",
      "Bash(Select-String:*)"
    ],
    "ask": [
      "Bash(git reset:*)",
      "Bash(git rebase:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(rm -rf:*)",
      "Bash(Remove-Item -Recurse:*)",
      "Read(./.mcp.json)",
      "Read(../unreal-horde-references/**/*.uasset)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_brief.py\"", "timeout": 20 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/bench_guard.py\"", "timeout": 20 },
          { "type": "command", "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/commit_gate.py\"", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          { "type": "command", "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/doc_check.py\"", "timeout": 20 }
        ]
      }
    ]
  }
}